{
  "name": "seacommons-console",
  "private": true,
  "version": "0.0.0",
  "description": "Operational maritime SAR and forensic drift console for SeaCommons.",
  "homepage": "https://seacommons.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/suezcanalxyz/seacommons.git"
  },
  "bugs": {
    "url": "https://github.com/suezcanalxyz/seacommons/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "bash ../../scripts/run_dev.sh all",
    "build": "vite build",
    "build:unified": "vite build && node scripts/package-unified.mjs",
    "clean": "rm -rf dist",
    "lint": "npm run lint:js && npm run typecheck",
    "lint:js": "eslint src --quiet",
    "lint:js:full": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:simulation && npm run test:live && npm run test:api && npm run test:map && npm run test:play",
    "test:api": "node --test src/services/api/*.test.js",
    "test:live": "node --test src/features/live/*.test.js",
    "test:map": "node --test src/features/drift/*.test.js src/features/map/*.test.js",
    "test:simulation": "node --test src/simulation/*.test.js",
    "test:play": "node --test src/features/play/*.test.js",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:e2e:production": "playwright test --config=playwright.production.config.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "animejs": "^4.5.0",
    "cesium": "^1.144.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.5.0",
    "ogl": "^1.0.11",
    "oidc-client-ts": "^3.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
