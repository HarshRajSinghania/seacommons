# SeaCommons — production environment template
# Copy to /etc/seacommons.env on the Oracle VM, then fill in real values.
# NEVER commit this file with real secrets. The .gitignore blocks .env* files.
#
#   sudo cp /home/ubuntu/seacommons/ops/.env.production.example /etc/seacommons.env
#   sudo nano /etc/seacommons.env
#   sudo chmod 600 /etc/seacommons.env

# ── Database ─────────────────────────────────────────────────────────────────
# Leave as-is to use SQLite (fine for single-VM pilot).
# For PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DB
DATABASE_URL=sqlite:////home/ubuntu/seacommons/apps/api/core/data/suezcanal_pilot.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=https://engine.seacommons.org,https://console.seacommons.org
PUBLIC_API_URL=https://api.seacommons.org

# Meta WhatsApp Cloud platform application. Do not put partner tokens here:
# partner credentials belong in Oracle Vault and are represented only by secret_ref.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ── AIS stream ───────────────────────────────────────────────────────────────
# Get a free key at https://aisstream.io
AISSTREAM_KEY=
# Optional: a SEPARATE AISStream key (different account) for a dedicated
# global subscription tracking the known NGO/SAR fleet by MMSI. Must be a
# different key than AISSTREAM_KEY above — AISStream allows only one open
# connection per key, so reusing the same key here gets the connection
# dropped immediately. Leave unset to skip this subscription.
AISSTREAM_NGO_KEY=

# ── CMEMS (Copernicus Marine) ─────────────────────────────────────────────────
# Register free at https://marine.copernicus.eu
CMEMS_USERNAME=
CMEMS_PASSWORD=

# ── Intel / OSINT layer ───────────────────────────────────────────────────────
INTEL_ENABLED=true

# Twitter/X API v2 Bearer token. NOT free since Feb 2023 — read/search access
# requires a paid Basic+ tier, and X separately meters some calls against a
# prepaid credit balance (search/recent can 402 "credits depleted" even with
# a valid token). Leave blank to run without this channel; Alarm Phone's
# distress feed does not depend on it (see alarm_phone_monitor.py).
# https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=

# Twikit — free X ingestion via the account's own browser session (cookies).
# Primary X source when enabled. Strictly opt-in; both vars must be set.
# Cookies file: browser export (auth_token + ct0 at minimum) placed at e.g.
# /etc/seacommons/twikit_cookies.json with chmod 600. Never commit it.
# Events are labelled source_policy="unofficial" (excluded from the public
# live map), except genuine distress calls which are labelled
# operator_published/published so they appear live. Keep the polling interval
# generous to protect the account.
# NOTE: the map-screenshot coordinates are read by OCR, which needs the
# `tesseract` binary (with eng traineddata) on the host. The Docker image
# installs it automatically; on bare-metal/VM run
#   sudo apt-get install -y tesseract-ocr tesseract-ocr-eng
# (ops/deploy-oracle.sh does this for the Oracle VM).
TWIKIT_ENABLED=false
TWIKIT_COOKIES_FILE=/etc/seacommons/twikit_cookies.json
# Tiered, not always-on: each sweep only polls accounts whose interval has
# elapsed. Priority accounts are polled near-real-time; the rest at base rate.
TWIKIT_POLL_INTERVAL_S=300
TWIKIT_PRIORITY_ACCOUNTS=alarm_phone
TWIKIT_PRIORITY_POLL_INTERVAL_S=45
# Comma-separated X screen names to track (no @). Empty => NGO_TWITTER_HANDLES.
TWIKIT_ACCOUNTS=alarm_phone,MSF_Sea,openarms_fund,sosmediterranee,seawatchcrew,SOShumanity,SeaEye4,ResQship,emergencyita,watchthemed,InfoMigrants,IOM_Italy,UNHCR_Italia
# Telegram notification when a tracked account posts (needs TELEGRAM_BOT_TOKEN
# + TELEGRAM_OPERATIONS_CHAT_ID).
TWIKIT_ALERTS_ENABLED=false

# ── Global Fishing Watch (optional, free, non-commercial) ─────────────────────
# Independent corroboration for AIS-derived grey-zone anomalies (encounters,
# loitering, AIS-disabling gaps) — core.intel.gfw_monitor is already scheduled
# (core/scheduler.py) and is a no-op until this is set. Register free at
# https://globalfishingwatch.org/our-apis/ (Developer Portal -> Create Token).
GFW_API_TOKEN=

# ── Remote maritime radio (optional) ───────────────────────────────────────────
# core/radio/catalog.py already ships a pre-cleared catalog of 15 public
# KiwiSDR/OpenWebRX HF receivers across the Mediterranean (terms_status=
# allowed, generic public-receiver monitor-only terms already declared) —
# nothing else to configure to use that catalog. Set REMOTE_RADIO_RECEIVERS_
# JSON/_FILE only to add receivers beyond that built-in list. This was
# previously kept disabled pending explicit production authorization
# (docs/current_work.md); enable only once that authorization is given.
REMOTE_RADIO_ENABLED=false
REMOTE_RADIO_FAILOVER_ENABLED=false
# REMOTE_RADIO_RECEIVERS_JSON=
# REMOTE_RADIO_RECEIVERS_FILE=

# ── TimeZero Professional bridge (optional) ───────────────────────────────────
TIMEZERO_ENABLED=false
TIMEZERO_HOST=localhost
TIMEZERO_PORT=4371

# ── Runtime ───────────────────────────────────────────────────────────────────
RUNTIME_PROFILE=operational
PYTHONUNBUFFERED=1
